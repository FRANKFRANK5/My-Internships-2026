import unittest
from unittest.mock import patch
# 📦 Importing the secure application engine
from frank_secure_auth import app

class SQLInjectionTest(unittest.TestCase):
    """
    🛡️ [SECURITY AUDIT CLASS] 🛡️
    Focus: Verifying that Parameterized Queries effectively neutralize SQL Injection.
    Method: Mocking the Database layer to isolate and test Application Logic.
    """

    @patch('sqlite3.connect')
    def test_sql_injection_mitigation(self, mock_connect):
        """
        ⚔️ [ATTACK SIMULATION] ⚔️
        Simulating a classic 'OR 1=1' bypass attempt.
        """
        # 🧪 MOCKING: Configuring the virtual database cursor
        mock_cursor = mock_connect.return_value.cursor.return_value
        mock_cursor.fetchone.return_value = None  # Simulating zero match for malicious input

        # 🚩 PAYLOAD: Typical SQL Injection strings
        malicious_username = "' OR '1'='1"
        malicious_password = "' OR '1'='1"

        # 🚀 EXECUTION: Triggering the login sequence with injected payloads
        with app.test_client() as client:
            response = client.post('/login', data={
                'username': malicious_username, 
                'password': malicious_password
            }, follow_redirects=True)

            # ✅ VERIFICATION: System must reject the attack and return to login failure
            # Standardized check for secure handling of invalid/malicious input
            self.assertIn(b'Authentication Failed', response.data)

if __name__ == '__main__':
    # 🎯 Triggering the Automated Security Audit
    print("🚀 Starting Automated SQLi Shield Test...")
    unittest.main()